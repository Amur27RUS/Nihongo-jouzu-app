[Unit]
Description=Nihongo VPS read-only metrics collector
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=10001
WorkingDirectory=/opt/nihongo-jouzu
EnvironmentFile=/opt/nihongo-jouzu/.env
ExecStart=/usr/bin/python3 /opt/nihongo-jouzu/tools/collect_monitor.py --output /opt/nihongo-jouzu/monitor/status.json --url https://${SITE_HOST}
TimeoutStartSec=55
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nihongo-jouzu/monitor
